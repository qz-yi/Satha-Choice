# ===================================
# SATHA CHOICE CLIENT - PRODUCTION
# ===================================
# This file is used during the production build

# API Configuration
# IMPORTANT: Update these URLs with your actual server domain/IP
VITE_API_URL=https://yourdomain.com
VITE_SOCKET_URL=https://yourdomain.com

# Google Maps API Key (Optional)
VITE_GOOGLE_MAPS_KEY=

# Environment
VITE_NODE_ENV=production

# ===================================
# DEPLOYMENT INSTRUCTIONS
# ===================================
# Before building for production:
# 1. Replace 'yourdomain.com' with your actual server domain or IP
# 2. If using HTTPS, ensure your server has SSL certificates
# 3. Run: npm run build
# 4. The dist/ folder will contain your production-ready files
# 5. Deploy the dist/ folder to your web server
