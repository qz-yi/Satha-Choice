# ===================================
# SATHA CHOICE - PRODUCTION DEPLOYMENT
# ===================================
# Copy this file and update with your actual server details

# Database Configuration (Update with your production database)
DATABASE_URL=postgresql://username:password@your-server-ip:5432/satha_choice

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration
# Add your actual domain here
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ===================================
# DEPLOYMENT INSTRUCTIONS
# ===================================
# 1. Copy this file to .env on your production server
# 2. Update DATABASE_URL with your PostgreSQL credentials
# 3. Update ALLOWED_ORIGINS with your actual domain
# 4. Generate a secure SESSION_SECRET (use: openssl rand -base64 32)
# 5. Ensure PostgreSQL is running and accessible
# 6. Run: npm run build (on client)
# 7. Run: npm start (to start the production server)
