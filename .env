# ===================================
# SATHA CHOICE - PRODUCTION CONFIGURATION
# ===================================

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/satha_choice

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (comma-separated origins)
# For production, replace with your actual domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Security
SESSION_SECRET=satha_secret_key_change_in_production

# يرجى تحديث DATABASE_URL بمعلومات قاعدة البيانات الصحيحة:
# DATABASE_URL=postgresql://username:password@host:port/database_name

# للإنتاج (Production):
# DATABASE_URL=postgresql://username:password@your-server-ip:5432/satha_choice
# PORT=5000
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com

# ملاحظة: يجب تشغيل PostgreSQL أولاً على المنفذ 5432
# يمكنك استخدام Docker: docker run -e POSTGRES_PASSWORD=password -p 5432:5432 -d postgres
