# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/satha_choice

# Server Configuration
PORT=3000

# يرجى تحديث DATABASE_URL بمعلومات قاعدة البيانات الصحيحة:
# DATABASE_URL=postgresql://username:password@host:port/database_name

# ملاحظة: يجب تشغيل PostgreSQL أولاً على المنفذ 5432
# يمكنك استخدام Docker: docker run -e POSTGRES_PASSWORD=password -p 5432:5432 -d postgres
